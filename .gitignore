# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# codex dev server logs
.codex-*.log

# env files (can opt-in for committing if needed)
.env*
# ...but the committed template must be tracked.
!.env.example

# local DB backups — never commit (may contain PII / password hashes)
/backups/

# scripts/seed-products.ts output — local only, never commit
/scripts/.seed-manifests/
/scripts/.seed-logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
