# Application / authentication
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_PEPPER=replace-with-a-different-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_ORIGINS=
TRUST_PROXY=false
CSP_MODE=report-only

# Runtime / database
PORT=3000
HOSTNAME=localhost
MONGODB_URL=mongodb://127.0.0.1:27017/ecommerce_shop?replicaSet=rs0
CRON_SECRET=replace-with-a-long-random-secret

# Mail
# resend | smtp | console. Production BẮT BUỘC khai báo, không tự suy từ biến khác:
# suy ngầm nghĩa là quên đặt key thì hệ thống lặng lẽ đổi provider mà không ai biết.
# console chỉ in ra terminal và bị cấm ở production.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Secret ký webhook. Thiếu nó thì chỉ biết Resend đã "nhận" mail, không biết đã giao hay bounce.
RESEND_WEBHOOK_SECRET=
# Phải thuộc domain đã verify ở Resend. Không gửi được từ @gmail.com.
MAIL_FROM="MultiCart <no-reply@mail.multicart.vn>"
# Đặt thấp hơn hạn mức mặc định của Resend để còn biên an toàn khi cron quét một lô lớn.
MAIL_RATE_PER_SECOND=4
MAIL_TIMEOUT_MS=10000

# SMTP chỉ dùng được khi chạy local hoặc trên hosting cho phép kết nối SMTP ra ngoài.
# KHÔNG phải đường rollback trên Render Free: nền tảng này chặn các cổng SMTP thông dụng,
# nên đặt MAIL_PROVIDER=smtp ở đó sẽ hỏng chứ không cứu được gì. Trên Render, cách lùi là
# sửa cấu hình Resend, không phải đổi provider.
# Không có failover tự động giữa hai provider — phải đổi MAIL_PROVIDER có chủ đích.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_APIKEY=
CLOUDINARY_CLOUD_APISECRET=

# GHN
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_VERIFY=false

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders

# Admin
# ADMIN_EMAIL là người nhận thông báo khi case hoàn/trả bị đẩy lên trọng tài (escalated).
# KHÔNG phải biến chỉ dùng cho CLI: thiếu nó thì mail escalate im lặng biến mất, admin
# không biết có case đang chờ xử. Bắt buộc ở production.
ADMIN_EMAIL=

# CLI-only admin seed (scripts/seed-admin.ts)
ADMIN_NAME=
ADMIN_PASSWORD=
